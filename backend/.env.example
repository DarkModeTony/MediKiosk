DATABASE_URL=postgresql://user:password@localhost:5432/mediplatform_db

# Security & Authentication
AUTH_ENFORCE=false
JWT_SECRET_KEY=mediplatform-insecure-development-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configurations
# 1. Voice Transcription (ASR): "mock" | "sarvam"
ASR_MODE=mock
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Document OCR: "mock" | "paddle" | "gemini"
OCR_MODE=mock

# 3. Medical Entity Extraction from OCR: "mock" | "gemini"
EXTRACTION_MODE=mock

# 4. Conversational Clinical NLU: "mock" | "gemini"
NLU_MODE=mock

# 5. Pre-consultation Summarization: "mock" | "real" (with LLM_PROVIDER="gemini" | "openai")
AI_MODE=mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
